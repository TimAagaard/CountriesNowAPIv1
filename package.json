{
    "name": "countriesnowapi",
    "version": "1.0.0",
    "main": "src/index.ts",
    "engines": {
        "node": ">=22.14.0"
    },
    "scripts": {
        "dev": "tsx --watch --env-file .env src/index.ts",
        "start": "node --env-file .env dist/index.js",
        "build": "tsc",
        "type-check": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "jest --coverage",
        "db:export": "tsx tools/export.ts",
        "db:import": "tsx tools/importNDJSON.ts",
        "db:import-raw": "node tools/importRaw.js",
        "db:truncate": "tsx tools/truncate.ts",
        "db:migrate": "prisma migrate dev --schema src/models/prisma",
        "db:generate": "prisma generate --schema src/models/prisma"
    },
    "type": "module",
    "author": "",
    "license": "MIT",
    "description": "",
    "devDependencies": {
        "@eslint/js": "^9.21.0",
        "@tsconfig/node22": "^22.0.0",
        "@types/express": "^5.0.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.13.9",
        "@types/supertest": "^6.0.3",
        "@types/swagger-ui-express": "^4.1.8",
        "eslint": "^9.21.0",
        "eslint-plugin-openapi": "^0.0.4",
        "eslint-plugin-perfectionist": "^4.9.0",
        "glob": "^11.0.1",
        "jest": "^29.7.0",
        "jest-sorted": "^1.0.15",
        "prettier": "^3.5.3",
        "prisma": "^6.5.0",
        "supertest": "^7.1.0",
        "ts-jest": "^29.3.2",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.19.3",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.26.0"
    },
    "dependencies": {
        "@prisma/client": "^6.5.0",
        "express": "^4.21.2",
        "geolib": "^3.3.4",
        "openapi-comment-parser": "^1.0.0",
        "swagger-ui-express": "^5.0.1"
    },
    "imports": {
        "#*": "./src/*"
    }
}
